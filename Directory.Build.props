<Project>
  <PropertyGroup>
    <!-- Default version for local builds. CI overrides this (via the Version
         MSBuild property / environment variable, stamped from the release tag)
         so AssemblyVersion/FileVersion — and therefore the version reported by
         the CLI, which the Linux updater compares against the release — track
         each release. AssemblyVersion/FileVersion derive from Version when not set. -->
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
  </PropertyGroup>
</Project>
