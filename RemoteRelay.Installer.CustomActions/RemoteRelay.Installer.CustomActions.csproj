<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RemoteRelay.Installer.CustomActions</RootNamespace>
    <AssemblyName>RemoteRelay.Installer.CustomActions</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <Version>1.0.0</Version>
    <!-- This project (and RemoteRelay.Installer) is excluded from the default
         solution build via the .sln (no .Build.0 entries). It targets net472 and
         is Windows-only, so it is built explicitly by CI/the installer instead. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Dtf.CustomAction" Version="5.0.2" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates\config.json.template" />
    <EmbeddedResource Include="Templates\ClientConfig.json.template" />
  </ItemGroup>

</Project>
