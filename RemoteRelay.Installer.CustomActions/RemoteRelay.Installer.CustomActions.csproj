<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RemoteRelay.Installer.CustomActions</RootNamespace>
    <AssemblyName>RemoteRelay.Installer.CustomActions</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <!-- This project is only built explicitly by the installer; opt out of the default solution build -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Dtf.CustomAction" Version="5.0.2" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates\config.json.template" />
    <EmbeddedResource Include="Templates\ClientConfig.json.template" />
  </ItemGroup>

</Project>
