<?xml version="1.0" encoding="utf-8"?>
<!-- MakeSfxCA embeds a file named exactly "CustomAction.config" as the managed
     custom-action host's app.config. Without it the DTF host loads the v2.0 CLR
     and fails to load this net472 assembly with a BadImageFormatException
     ("built by a runtime newer than the currently loaded runtime"), which aborts
     the install (error 1603) and rolls everything back. -->
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" />
  </startup>
</configuration>
