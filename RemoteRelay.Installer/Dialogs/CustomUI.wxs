<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Fragment>
    <!--
      WixUI_RemoteRelay_Overrides extends WixUI_FeatureTree with two extra
      dialogs (ServerConfigDlg and ClientConfigDlg) shown after the
      feature-selection step. Each is gated on its feature being selected.

      Feature action-state == 3 means "selected, will be installed locally".
    -->
    <UI Id="WixUI_RemoteRelay_Overrides">
      <DialogRef Id="ServerConfigDlg" />
      <DialogRef Id="ClientConfigDlg" />
      <DialogRef Id="RemoveConfigDlg" />

      <!-- Remove flow: intercept the MaintenanceTypeDlg Remove button so the user can
           choose to keep or delete config before VerifyReadyDlg. Higher Order than the
           ext's default NewDialog->VerifyReadyDlg publish, so this wins. -->
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog"
               Value="RemoveConfigDlg" Order="10" Condition="1" />
      <Publish Dialog="RemoveConfigDlg" Control="Back" Event="NewDialog"
               Value="MaintenanceTypeDlg" />
      <Publish Dialog="RemoveConfigDlg" Control="Next" Event="NewDialog"
               Value="VerifyReadyDlg" />
      <Publish Dialog="RemoveConfigDlg" Control="Cancel" Event="SpawnDialog"
               Value="CancelDlg" />
      <!-- When VerifyReadyDlg is reached via the Remove flow, send Back to our dialog. -->
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog"
               Value="RemoveConfigDlg" Order="10"
               Condition="WixUI_InstallMode = &quot;Remove&quot;" />

      <!-- After CustomizeDlg (feature tree): branch on which features are selected. -->
      <Publish Dialog="CustomizeDlg" Control="Next" Event="NewDialog"
               Value="ServerConfigDlg" Order="3" Condition="&amp;ServerFeature=3" />
      <Publish Dialog="CustomizeDlg" Control="Next" Event="NewDialog"
               Value="ClientConfigDlg" Order="4"
               Condition="(&amp;ServerFeature&lt;&gt;3) AND (&amp;ClientFeature=3)" />
      <Publish Dialog="CustomizeDlg" Control="Next" Event="NewDialog"
               Value="VerifyReadyDlg" Order="5"
               Condition="(&amp;ServerFeature&lt;&gt;3) AND (&amp;ClientFeature&lt;&gt;3)" />

      <!-- ServerConfigDlg navigation -->
      <Publish Dialog="ServerConfigDlg" Control="Back" Event="NewDialog"
               Value="CustomizeDlg" />
      <Publish Dialog="ServerConfigDlg" Control="Next" Event="NewDialog"
               Value="ClientConfigDlg" Order="1" Condition="&amp;ClientFeature=3" />
      <Publish Dialog="ServerConfigDlg" Control="Next" Event="NewDialog"
               Value="VerifyReadyDlg" Order="2" Condition="&amp;ClientFeature&lt;&gt;3" />
      <Publish Dialog="ServerConfigDlg" Control="Cancel" Event="SpawnDialog"
               Value="CancelDlg" />

      <!-- ClientConfigDlg navigation -->
      <Publish Dialog="ClientConfigDlg" Control="Back" Event="NewDialog"
               Value="ServerConfigDlg" Order="1" Condition="&amp;ServerFeature=3" />
      <Publish Dialog="ClientConfigDlg" Control="Back" Event="NewDialog"
               Value="CustomizeDlg" Order="2" Condition="&amp;ServerFeature&lt;&gt;3" />
      <Publish Dialog="ClientConfigDlg" Control="Next" Event="NewDialog"
               Value="VerifyReadyDlg" />
      <Publish Dialog="ClientConfigDlg" Control="Cancel" Event="SpawnDialog"
               Value="CancelDlg" />

      <!-- VerifyReadyDlg Back: walk the reverse route -->
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog"
               Value="ClientConfigDlg" Order="3" Condition="&amp;ClientFeature=3" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog"
               Value="ServerConfigDlg" Order="4"
               Condition="(&amp;ClientFeature&lt;&gt;3) AND (&amp;ServerFeature=3)" />
    </UI>
  </Fragment>
</Wix>
